# Copy to .env and fill in local values. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=food_commerce
DB_USER=your_db_user
DB_PASSWORD=replace_with_your_password

# Gemini connection check: python -m scripts.check_llm
GEMINI_API_KEY=
LLM_ENABLED=true
LLM_QUERY_ENABLED=true
# 상품 조건 해석 프롬프트 버전: v2(기본, 포장 단일 값·미지원 기준 명시) / v1(2026-10-06 원본, 비교용)
LLM_QUERY_PROMPT_VERSION=v2
LLM_FAQ_ENABLED=true
LLM_FAQ_MODEL=gemini-3.5-flash-lite
LLM_PROVIDER=
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
