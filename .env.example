# Copy to .env and fill in local values. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=food_commerce
DB_USER=your_db_user
DB_PASSWORD=replace_with_your_password

# Gemini connection check: python -m scripts.check_llm
GEMINI_API_KEY=
LLM_ENABLED=true
LLM_QUERY_ENABLED=true
LLM_FAQ_ENABLED=true
LLM_FAQ_MODEL=gemini-3.5-flash-lite
LLM_PROVIDER=
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
